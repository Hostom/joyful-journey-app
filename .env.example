# Configurações de Integração da API do CRM

# Token que o CRM usará para se autenticar ao enviar imóveis para o Site (CRM -> Site)
# Cabeçalho: Authorization: Bearer <TOKEN>
CRM_TO_SITE_BEARER_TOKEN="etC008AEvQiD_XPTv7aqKac1wcrZWeptsAYZiKaaHnI"

# Chave que o Site usará para se autenticar ao enviar cadastros de clientes para o CRM (Site -> CRM)
# Cabeçalho: X-API-Key: <CHAVE>
SITE_TO_CRM_API_KEY="d13d9bab9a3874f27ec3d056cfe5227dd19021ff15d4cc26"

# URL do endpoint de Leads do seu CRM
CRM_LEADS_API_URL="https://api.crm-exemplo.com/v1/leads"
